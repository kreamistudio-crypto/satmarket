{
  "manifest_version": 3,
  "name": "Barattolo per Amazon",
  "short_name": "Barattolo",
  "description": "Compra su amazon.it con Barattozon: paghi in contanti con un PayCode, lo pubblichi su Barattolo e te lo salda chi compra i tuoi sats.",
  "version": "0.3.0",
  "homepage_url": "https://barattolo.store",
  "icons": {
    "16": "icone/16.png",
    "32": "icone/32.png",
    "48": "icone/48.png",
    "128": "icone/128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.amazon.it/*"],
      "js": ["amazon.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "estensione@barattolo.store",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
