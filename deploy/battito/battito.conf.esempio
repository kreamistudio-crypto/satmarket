# /etc/battito/battito.conf — root, 600. NON va nel repo col segreto vero.
# Il segreto e' BATTITO_SEGRETO del config del VPS: lo stesso valore su
# tutte le macchine. Si scrive solo con `read -s` (PRODUZIONE, «IL QUADRO
# DEI SERVIZI E I BATTITI»), mai a mano in chat.
BATTITO_URL="https://barattolo.store/api/battito"
BATTITO_SEGRETO="INCOLLA_QUI"
# Il nome della macchina negli avvisi (di serie: hostname)
MACCHINA="RELAY"
# SOLO SUL NODO: esce da Tor, come la ronda
# TOR_SOCKS="172.28.1.3:9050"
# SOLO SUL RELAY: l'occhio da fuori sul VPS, e il Telegram per gridarlo.
# Il file si legge con la shell: il Telegram si prende da quello della
# ronda del relay, senza copiare il token una seconda volta.
# GUARDA_VPS=1
# . /opt/relay/telegram.conf; TG_TOKEN="$BOT_TOKEN"; TG_CHAT="$CHAT_ID"
