# mutinynet-vm.env — la VM «rgb-prova» su MUTINYNET coi servizi degli
# organizzatori dell'hackathon (studio del 9 ott 2026, deciso con Alan).
# Sulla VM sta in ~/rgb/mutinynet.env e si fa `source ~/rgb/mutinynet.env`
# PRIMA di ogni `rgb.py …` e di `rgb_http.py`: senza, i comandi parlano
# col signet della VM (bitcoind+electrs del compose), che resta intatto
# come piano B. Per rgb-lib la rete e' SIGNET in tutt'e due i casi (stesso
# blocco 0): quel che cambia e' qui sotto, e la cartella dei wallet.
#
# Il controllo che l'ambiente sia quello giusto: `rgb.py saldo barattolo`
# si rifiuta di aprire un wallet nato sull'altra catena (chiavi.json).

export RGB_CATENA=mutinynet
export RGB_BASE=$HOME/rgb/mutinynet            # i wallet di Mutinynet: MAI la cartella del signet (~/rgb/dati)
export RGB_BACKUP=$HOME/rgb/backup-mutinynet   # le fotografie .rgb-backup di questi wallet

# L'indexer: Esplora via https (su Mutinynet NON esiste un Electrum pubblico).
export RGB_INDEXER=https://esplora.signet.kaleidoswap.com
# Il proxy RGB: pubblico, protocollo 0.2, versione 0.3.0 come il container
# della VM. Sta DENTRO le fatture: cambiarlo vuol dire rifare le fatture aperte.
export RGB_PROXY=rpcs://proxy.kaleidoswap.com/json-rpc

# LE RISERVE (si scommenta la riga e si commenta quella sopra):
# export RGB_INDEXER=https://mutinynet.com/api               # l'Esplora di Mutiny: ha dato 429 (rate limit) alla CI di KaleidoSwap
# export RGB_PROXY=rpcs://proxy.iriswallet.com/0.2/json-rpc  # il proxy di Iris, stessa versione 0.3.0

# I LINK alle transazioni li sceglie rgb.py dalla catena: https://mutinynet.com/tx/<txid>
