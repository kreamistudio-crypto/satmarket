# mutinynet-wsl.env — il portatile (WSL di Andrea, o il Linux di Alan) su
# MUTINYNET coi servizi degli organizzatori (studio del 9 ott 2026). Sta in
# ~/wdk-prova/mutinynet.env e si fa `source ~/wdk-prova/mutinynet.env` PRIMA
# di `node punti.mjs …`, `node nwc-wdk.mjs serve` e `node identita.mjs
# annuncio …`. Senza, gli script parlano col tunnel verso la VM signet
# (127.0.0.1:50001 e :3000), che resta il piano B.
#
# Il tunnel SSH verso la VM perde le gambe 50001 e 3000 (indexer e proxy
# sono pubblici) e tiene la sola 8787 (rgb_http.py):
#   ssh -i ~/.ssh/lnvps -N -L 8787:127.0.0.1:8787 debian@vm-2050.lnvps.cloud
#
# Il servizio NWC NON cambia chiave ne' connection string: il Profilo di
# Barattolo resta collegato. Cambia solo il wallet che apre (la casa qui sotto).

export RGB_CATENA=mutinynet
export PUNTI_CASA=$HOME/wdk-prova/mutinynet/utente   # il wallet utente di Mutinynet: MAI ~/wdk-prova/utente (signet)

# L'indexer: Esplora via https (su Mutinynet NON esiste un Electrum pubblico).
export RGB_INDEXER=https://esplora.signet.kaleidoswap.com
# Il proxy RGB pubblico (protocollo 0.2, versione 0.3.0): sta DENTRO le fatture.
export RGB_PROXY=rpcs://proxy.kaleidoswap.com/json-rpc

# LE RISERVE (si scommenta la riga e si commenta quella sopra):
# export RGB_INDEXER=https://mutinynet.com/api               # l'Esplora di Mutiny: ha dato 429 (rate limit) alla CI di KaleidoSwap
# export RGB_PROXY=rpcs://proxy.iriswallet.com/0.2/json-rpc  # il proxy di Iris, stessa versione 0.3.0

# I LINK alle transazioni li sceglie punti.mjs dalla catena: https://mutinynet.com/tx/<txid>
