diff --git a/src/app/bond/flow.rs b/src/app/bond/flow.rs
index 9888544..c7bdc7d 100644
--- a/src/app/bond/flow.rs
+++ b/src/app/bond/flow.rs
@@ -124,6 +124,50 @@ pub fn taker_bond_required_for(order: &Order) -> bool {
     taker_bond_required() && bond_applies_to_order(order)
 }
 
+/// Barattolo fork (patch 0010): [`taker_bond_required`] for THIS take,
+/// decided on the payment method the taker declared
+/// (`Payload::Order.payment_method`, read by `util::taker_payment_method`)
+/// when the order offers it; otherwise, as patch 0008, on the order's
+/// whole list. A taker who picks an online method on a «SEPA, Contanti»
+/// order posts no bond; one who picks «Contanti» does.
+pub fn taker_bond_required_for_take(order: &Order, declared: Option<&str>) -> bool {
+    taker_bond_required() && bond_applies_to_take(order, declared)
+}
+
+/// [`bond_applies_to_order`] for THIS take (patch 0010): the policy from
+/// the settings, the rest in [`bond_applies_to_take_with`].
+pub fn bond_applies_to_take(order: &Order, declared: Option<&str>) -> bool {
+    Settings::get_bond()
+        .map(|cfg| {
+            bond_applies_to_take_with(&order.payment_method, declared, &cfg.only_payment_methods)
+        })
+        .unwrap_or(false)
+}
+
+/// Pure (patch 0010): `offered` is the order's comma-separated list,
+/// `declared` the taker's method, `allowed` the policy's list. The
+/// declared method counts only when it is one of the offered ones (whole
+/// word, trimmed, case-insensitive): then the bond applies iff it is in
+/// the policy. With no usable declaration the order's whole list decides
+/// (patch 0008): a client cannot dodge the bond by naming a method the
+/// order does not offer, and a client that declares nothing keeps the
+/// rule of yesterday.
+pub fn bond_applies_to_take_with(offered: &str, declared: Option<&str>, allowed: &[String]) -> bool {
+    if let Some(d) = declared
+        .map(|d| d.trim().to_lowercase())
+        .filter(|d| !d.is_empty())
+    {
+        let offered_lower: Vec<String> = offered
+            .split(',')
+            .map(|m| m.trim().to_lowercase())
+            .collect();
+        if offered_lower.contains(&d) {
+            return payment_method_in(&d, allowed);
+        }
+    }
+    payment_method_in(offered, allowed)
+}
+
 /// [`maker_bond_required`] for THIS order (patch 0008).
 pub fn maker_bond_required_for(order: &Order) -> bool {
     maker_bond_required() && bond_applies_to_order(order)
@@ -5019,3 +5063,47 @@ mod barattolo_bond_methods {
         assert!(!maker_bond_required_for(&order));
     }
 }
+
+#[cfg(test)]
+mod barattolo_bond_take {
+    // Barattolo fork (patch 0010): the bond decided on the method the
+    // taker declares, only when the order offers it.
+    use super::bond_applies_to_take_with;
+
+    fn v(a: &[&str]) -> Vec<String> {
+        a.iter().map(|s| s.to_string()).collect()
+    }
+
+    #[test]
+    fn declared_method_decides_when_the_order_offers_it() {
+        let p = v(&["Contanti"]);
+        assert!(!bond_applies_to_take_with("SEPA, Contanti", Some("SEPA"), &p));
+        assert!(!bond_applies_to_take_with("Satispay,PayPal,Contanti", Some(" paypal "), &p));
+        assert!(bond_applies_to_take_with("SEPA, Contanti", Some("Contanti"), &p));
+        assert!(bond_applies_to_take_with("SEPA, Contanti", Some("contanti"), &p));
+        assert!(bond_applies_to_take_with("Contanti", Some("Contanti"), &p));
+    }
+
+    #[test]
+    fn a_declaration_the_order_does_not_offer_falls_back_to_the_order() {
+        let p = v(&["Contanti"]);
+        // naming «SEPA» on a cash-only order does not dodge the bond
+        assert!(bond_applies_to_take_with("Contanti", Some("SEPA"), &p));
+        // naming «Contanti» on a SEPA-only order does not create one
+        assert!(!bond_applies_to_take_with("SEPA", Some("Contanti"), &p));
+        assert!(bond_applies_to_take_with("SEPA, Contanti", Some("Revolut"), &p));
+        assert!(bond_applies_to_take_with("SEPA, Contanti", Some(""), &p));
+        assert!(bond_applies_to_take_with("SEPA, Contanti", Some("   "), &p));
+        // no declaration at all: the rule of patch 0008
+        assert!(bond_applies_to_take_with("SEPA, Contanti", None, &p));
+        assert!(!bond_applies_to_take_with("SEPA", None, &p));
+        // Barattozon keeps its own exact name: never the cash bond
+        assert!(!bond_applies_to_take_with("Contanti al tabacchino 23.47", Some("Contanti al tabacchino 23.47"), &p));
+    }
+
+    #[test]
+    fn an_empty_policy_still_covers_every_take() {
+        assert!(bond_applies_to_take_with("SEPA, Contanti", Some("SEPA"), &v(&[])));
+        assert!(bond_applies_to_take_with("SEPA", None, &v(&[])));
+    }
+}
