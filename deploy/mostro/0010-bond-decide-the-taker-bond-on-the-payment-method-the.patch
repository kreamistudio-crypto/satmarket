+/// Barattolo fork (patch 0010): the payment method the taker declared in
+/// the take message, when the client sent `Payload::Order`. Trimmed;
+/// `None` when absent or empty (an upstream client sends `Amount` or
+/// nothing). The bond policy reads it through
+/// `bond::taker_bond_required_for_take`.
+pub fn taker_payment_method(msg: &Message) -> Option<String> {
+    let inner = msg.get_inner_message_kind();
+    if inner.action != Action::TakeSell && inner.action != Action::TakeBuy {
+        return None;
+    }
+    match &inner.payload {
+        Some(Payload::Order(small)) => {
+            let m = small.payment_method.trim();
+            if m.is_empty() {
+                None
+            } else {
+                Some(m.to_string())
+            }
+        }
+        _ => None,
+    }
+}
+
+/// Barattolo fork (patch 0010): the fiat amount a taker asked for on a
+/// range order when the take carries `Payload::Order`; `None` when the
+/// payload has another shape or the amount is not positive.
+pub fn taker_declared_amount(msg: &Message) -> Option<i64> {
+    let inner = msg.get_inner_message_kind();
+    if inner.action != Action::TakeSell && inner.action != Action::TakeBuy {
+        return None;
+    }
+    match &inner.payload {
+        Some(Payload::Order(small)) if small.fiat_amount > 0 => Some(small.fiat_amount),
+        _ => None,
+    }
+}
