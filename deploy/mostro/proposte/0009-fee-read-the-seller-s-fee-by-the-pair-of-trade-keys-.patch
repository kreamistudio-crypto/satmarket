 /// pays. Returns `(fee_buyer, fee_seller)`.
 pub fn fees_for(amount: i64, base_fee: f64, discount: f64, flags: (bool, bool)) -> (i64, i64) {
@@ -338,7 +409,19 @@ pub async fn apply_party_fees(pool: &SqlitePool, order: &mut Order, buyer: &str,
     }
     let (mut fee_buyer, mut fee_seller) = fees_for(order.amount, base_fee, discount_rate(), flags);
 
-    if let Err(e) = store(pool, &order_id, order.amount, fee_buyer, fee_seller, flags).await {
