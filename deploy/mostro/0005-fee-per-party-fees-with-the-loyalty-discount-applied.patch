+//! Barattolo fork, patch 0005: per-party fees.
+//!
+//! Upstream charges both parties the same fee: a single `order.fee` column
+//! is added to the seller's hold invoice and subtracted from the buyer's
+//! payout. This coordinator grants a small loyalty discount to some users,
+//! and applies it at the source, so the hold invoice and the payout are
+//! right the first time and nothing has to be refunded afterwards.
+//!
+//! How it fits without touching `mostro-core`:
+//!
+//! * `order.fee` becomes "the BUYER's fee". Every buyer-side use upstream
+//!   (`set_waiting_invoice_status`, `validate_invoice`, `do_payment`,
+//!   `check_failure_retries`, the buyer messages in `flow.rs` and
+//!   `add_invoice.rs`) keeps working byte for byte.
+//! * The SELLER's fee lives in a side table, `barattolo_fees`, created here
+//!   with `CREATE TABLE IF NOT EXISTS` and deliberately kept OUT of the sqlx
+//!   migrations, so an upstream migration can never collide with it. The
+//!   three seller-side uses (`show_hold_invoice`, and the seller messages in
+//!   `flow.rs` and `add_invoice.rs`) read it through [`seller_fee`].
+//!
+//! Who gets the discount is not this daemon's business: at take time it asks
+//! the marketplace server a yes/no question per trade key. The server never
+//! says HOW MUCH: the rate is local (`BARATTOLO_SCONTO_FEE`) and hard-capped
+//! by [`MAX_DISCOUNT`], so a compromised server can at most hand someone the
+//! discount, never rewrite a fee.
+//!
+//! Fail closed, everywhere: no answer, a slow answer, a non-200, malformed
+//! JSON, a key missing from the answer, a failed write of the side row, or
+//! the feature not being configured at all — each one means FULL fee. An
+//! unverified discount is never applied. Each failure logs one line with the
+//! reason, because a silent fallback is a fee nobody can explain later.
+//!
+//! Not covered: the anti-abuse bond path stashes `order.fee` in the taker
+//! context and may race several takers on one order; this coordinator runs
+//! with bonds disabled. Revisit before enabling them.
+
+use crate::config::settings::Settings;
+use crate::config::DB_POOL;
+use crate::util::get_dev_fee;
+use mostro_core::prelude::*;
+use sqlx::SqlitePool;
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use std::sync::OnceLock;
+use std::time::Duration;
+use tracing::{info, warn};
+
+/// Hard cap on the per-party discount, as a fraction of the amount. The
+/// configured rate is clamped to this no matter what the environment says.
+pub const MAX_DISCOUNT: f64 = 0.01;
+
+/// Whole budget for the lookup. The take handler runs in the serial message
+/// loop, so this is also the longest a dead server can stall a take. A cold
+/// Tor circuit measured 10.6 s on this node; the heartbeat below keeps the
+/// connection warm so the usual cost is about a second.
+const LOOKUP_BUDGET: Duration = Duration::from_secs(12);
+
+/// How often the keep-warm request goes out.
+const HEARTBEAT_EVERY: Duration = Duration::from_secs(60);
+
+/// The circuit breaker (audit of 19 Sep 2026, M4). The lookup runs in the
+/// serial message loop, so with the marketplace server down every take
+/// paid the whole `LOOKUP_BUDGET` — and a burst of takes from throwaway
+/// keys stalled the coordinator for free. After this many failures in a
+/// row the lookup is skipped for `BREAKER_PAUSE` (full fee for both, the
+/// usual fail-closed) and then tried again.
+const BREAKER_FAILS: u32 = 3;
+const BREAKER_PAUSE: Duration = Duration::from_secs(60);
+/// Hard cap on the server's answer (audit of 23 Sep 2026, B6): a
+/// `{"sconti": {<key>: bool}}` for two keys is a few hundred bytes, and
+/// a compromised server must not make the serial loop swallow gigabytes.
+const MAX_ANSWER_BYTES: usize = 65_536;
+
+static FAILS: AtomicU32 = AtomicU32::new(0);
+static PAUSED_UNTIL: AtomicU64 = AtomicU64::new(0);
+
+/// The pure half of the breaker: failures so far, the clock, whether this
+/// lookup succeeded -> failures after, and the unix time until which the
+/// lookup is paused (0 = not paused).
+pub fn breaker_after(fails: u32, now: u64, ok: bool) -> (u32, u64) {
+    if ok {
+        return (0, 0);
+    }
+    let fails = fails + 1;
+    if fails >= BREAKER_FAILS {
+        (0, now + BREAKER_PAUSE.as_secs())
+    } else {
+        (fails, 0)
+    }
+}
+
+fn now_secs() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+const ENV_RATE: &str = "BARATTOLO_SCONTO_FEE";
+const ENV_URL: &str = "BARATTOLO_SCONTO_URL";
+const ENV_SECRET: &str = "BARATTOLO_SCONTO_SEGRETO";
+
+/// Parses the configured discount. Anything that is not a finite number in
+/// `[0, MAX_DISCOUNT]` is clamped or dropped to zero: a typo must switch the
+/// discount off, never on.
+pub fn parse_discount(raw: Option<&str>) -> f64 {
+    let value = match raw.and_then(|s| s.trim().parse::<f64>().ok()) {
+        Some(v) if v.is_finite() && v > 0.0 => v,
+        _ => return 0.0,
+    };
+    value.min(MAX_DISCOUNT)
+}
+
+fn discount_rate() -> f64 {
+    parse_discount(std::env::var(ENV_RATE).ok().as_deref())
+}
+
+fn endpoint() -> Option<(String, String)> {
+    let url = std::env::var(ENV_URL).ok()?.trim().to_string();
+    let secret = std::env::var(ENV_SECRET).ok()?.trim().to_string();
+    if url.is_empty() || secret.is_empty() {
+        return None;
+    }
+    Some((url, secret))
+}
+
+/// One party's fee. With no discount this is exactly upstream's `get_fee`:
+/// `round(base_fee * amount / 2)`. With a discount the base is lowered by
+/// twice the discount first, so the halving below yields
+/// `amount * (base_fee / 2 - discount)`; the Barattolo client does the same
+/// arithmetic in the same order, which keeps the two within rounding.
+pub fn party_fee(amount: i64, base_fee: f64, discount: f64) -> i64 {
+    let discount = if discount.is_finite() && discount > 0.0 {
+        discount.min(MAX_DISCOUNT)
+    } else {
+        0.0
+    };
+    let base = if discount > 0.0 {
+        (base_fee - 2.0 * discount).max(0.0)
+    } else {
+        base_fee
+    };
+    ((base * amount as f64) / 2.0).round() as i64
+}
+
+/// Reads the server's answer. Only a literal JSON `true` under
+/// `sconti[<key>]` grants the discount; anything else is a no.
+pub fn parse_answer(body: &str, buyer: &str, seller: &str) -> (bool, bool) {
+    let value: serde_json::Value = match serde_json::from_str(body) {
+        Ok(v) => v,
+        Err(_) => return (false, false),
+    };
+    let table = &value["sconti"];
+    let yes = |key: &str| !key.is_empty() && table[key].as_bool() == Some(true);
+    (yes(buyer), yes(seller))
+}
+
+fn is_hex_key(key: &str) -> bool {
+    key.len() == 64 && key.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+fn http() -> &'static reqwest::Client {
+    static CLIENT: OnceLock<reqwest::Client> = OnceLock::new();
+    CLIENT.get_or_init(|| {
+        reqwest::Client::builder()
+            .timeout(LOOKUP_BUDGET)
+            .connect_timeout(LOOKUP_BUDGET)
+            .user_agent(concat!("mostro/", env!("CARGO_PKG_VERSION")))
+            .build()
+            .unwrap_or_default()
+    })
+}
+
+async fn ask_server(buyer: &str, seller: &str) -> Result<(bool, bool), String> {
+    let (url, secret) = endpoint().ok_or_else(|| "not configured".to_string())?;
+    let keys: Vec<&str> = [buyer, seller]
+        .into_iter()
+        .filter(|k| is_hex_key(k))
+        .collect();
+    if keys.is_empty() {
+        return Err("no usable trade key".to_string());
+    }
+    let response = http()
+        .post(&url)
+        .bearer_auth(&secret)
+        .json(&serde_json::json!({ "pubkeys": keys }))
+        .send()
+        .await
+        .map_err(|e| format!("request failed: {e}"))?;
+    if !response.status().is_success() {
+        return Err(format!("HTTP {}", response.status()));
+    }
+    if response.content_length().unwrap_or(0) > MAX_ANSWER_BYTES as u64 {
+        return Err("answer too large".to_string());
+    }
+    // read in chunks with the cap: a body without Content-Length (chunked)
+    // must not be slurped whole into memory inside the serial loop
+    let mut response = response;
+    let mut raw: Vec<u8> = Vec::new();
+    while let Some(chunk) = response
+        .chunk()
+        .await
+        .map_err(|e| format!("unreadable body: {e}"))?
+    {
+        if raw.len() + chunk.len() > MAX_ANSWER_BYTES {
+            return Err("answer too large".to_string());
+        }
+        raw.extend_from_slice(&chunk);
+    }
+    let body = String::from_utf8_lossy(&raw);
+    Ok(parse_answer(&body, buyer, seller))
+}
+
+/// (buyer, seller) discount flags. Never errors: every failure is a no.
+async fn lookup(order_id: &str, buyer: &str, seller: &str) -> (bool, bool) {
+    if discount_rate() <= 0.0 || endpoint().is_none() {
+        return (false, false);
+    }
+    let now = now_secs();
+    let paused_until = PAUSED_UNTIL.load(Ordering::Relaxed);
+    if now < paused_until {
+        info!(
+            "barattolo_fee: order {order_id}: discount lookup paused for {}s more after {BREAKER_FAILS} failures in a row: full fee for both",
+            paused_until - now
+        );
+        return (false, false);
+    }
+    let answer = match tokio::time::timeout(LOOKUP_BUDGET, ask_server(buyer, seller)).await {
+        Ok(Ok(flags)) => Some(flags),
+        Ok(Err(reason)) => {
+            warn!("barattolo_fee: order {order_id}: discount NOT verified ({reason}): full fee for both");
+            None
+        }
+        Err(_) => {
+            warn!(
+                "barattolo_fee: order {order_id}: discount NOT verified (no answer in {}s): full fee for both",
+                LOOKUP_BUDGET.as_secs()
+            );
+            None
+        }
+    };
+    let (fails, until) = breaker_after(FAILS.load(Ordering::Relaxed), now, answer.is_some());
+    FAILS.store(fails, Ordering::Relaxed);
+    if until > 0 {
+        PAUSED_UNTIL.store(until, Ordering::Relaxed);
+        warn!(
+            "barattolo_fee: {BREAKER_FAILS} failures in a row: the discount lookup pauses for {}s",
+            BREAKER_PAUSE.as_secs()
+        );
+    }
+    answer.unwrap_or((false, false))
+}
+
+async fn ensure_table(pool: &SqlitePool) -> Result<(), sqlx::Error> {
+    sqlx::query(
+        "CREATE TABLE IF NOT EXISTS barattolo_fees (
+            order_id TEXT PRIMARY KEY,
+            amount INTEGER NOT NULL,
+            fee_buyer INTEGER NOT NULL,
+            fee_seller INTEGER NOT NULL,
+            discount_buyer INTEGER NOT NULL DEFAULT 0,
+            discount_seller INTEGER NOT NULL DEFAULT 0,
+            created_at INTEGER NOT NULL
+        )",
+    )
+    .execute(pool)
+    .await
+    .map(|_| ())
+}
+
+async fn store(
+    pool: &SqlitePool,
+    order_id: &str,
+    amount: i64,
+    fee_buyer: i64,
+    fee_seller: i64,
+    flags: (bool, bool),
+) -> Result<(), sqlx::Error> {
+    ensure_table(pool).await?;
+    sqlx::query(
+        "INSERT OR REPLACE INTO barattolo_fees
+            (order_id, amount, fee_buyer, fee_seller, discount_buyer, discount_seller, created_at)
+         VALUES (?1, ?2, ?3, ?4, ?5, ?6, strftime('%s','now'))",
+    )
+    .bind(order_id)
+    .bind(amount)
+    .bind(fee_buyer)
+    .bind(fee_seller)
+    .bind(flags.0 as i64)
+    .bind(flags.1 as i64)
+    .execute(pool)
+    .await
+    .map(|_| ())
+}
+
+/// Was this order ever given per-party fees? An error (no table yet) is a no.
+async fn has_row(pool: &SqlitePool, order_id: &str) -> bool {
+    sqlx::query_as::<_, (i64,)>("SELECT 1 FROM barattolo_fees WHERE order_id = ?1")
+        .bind(order_id)
+        .fetch_optional(pool)
+        .await
+        .map(|row| row.is_some())
+        .unwrap_or(false)
+}
+
+/// The pure half of [`apply_party_fees`]: given the flags, what each party
+/// pays. Returns `(fee_buyer, fee_seller)`.
+pub fn fees_for(amount: i64, base_fee: f64, discount: f64, flags: (bool, bool)) -> (i64, i64) {
+    let pick = |granted: bool| if granted { discount } else { 0.0 };
+    (
+        party_fee(amount, base_fee, pick(flags.0)),
+        party_fee(amount, base_fee, pick(flags.1)),
+    )
+}
+
+/// Sets the fees of an order being taken. Call it once `order.amount` is
+/// final and both trade keys are known, BEFORE anything reads `order.fee`.
+///
+/// With no discount for either party AND no earlier row for this order, the
+/// order is left exactly as upstream computed it: same fee (a fixed-price
+/// order keeps the one frozen at creation), same dev fee, no row written.
+/// That is the whole world when the feature is not configured.
+///
+/// Otherwise it recomputes from `order.amount` and the configured base fee,
+/// never from the current `order.fee`: a fixed-price order that went back to
+/// the book after a timeout still carries the previous taker's discounted
+/// fee, and an earlier row is how that is recognised.
+///
+/// The side row is written FIRST and `order.fee` only afterwards. If the
+/// write fails nobody gets a discount, so a reader that finds no matching
+/// row can safely fall back to `order.fee`.
+pub async fn apply_party_fees(pool: &SqlitePool, order: &mut Order, buyer: &str, seller: &str) {
+    let base_fee = Settings::get_mostro().fee;
+    let order_id = order.id.to_string();
+    let flags = lookup(&order_id, buyer, seller).await;
+    if !flags.0 && !flags.1 && !has_row(pool, &order_id).await {
+        return;
+    }
+    let (mut fee_buyer, mut fee_seller) = fees_for(order.amount, base_fee, discount_rate(), flags);
+
+    if let Err(e) = store(pool, &order_id, order.amount, fee_buyer, fee_seller, flags).await {
+        warn!("barattolo_fee: order {order_id}: could not record the fees ({e}): full fee for both");
+        let full = party_fee(order.amount, base_fee, 0.0);
+        fee_buyer = full;
+        fee_seller = full;
+    } else if flags.0 || flags.1 {
+        info!(
+            "barattolo_fee: order {order_id}: amount {} fee buyer {fee_buyer} (discount {}) fee seller {fee_seller} (discount {})",
+            order.amount, flags.0, flags.1
+        );
+    }
+
+    order.fee = fee_buyer;
+    order.dev_fee = get_dev_fee(fee_buyer + fee_seller);
+}
+
+/// The seller's fee for `order`, from the side row written at take time.
+///
+/// The row is trusted only if it belongs to THIS take: same amount and same
+/// buyer fee as the order carries now. Otherwise — no row (an order taken
+/// before this patch, or a failed write), or a stale row from an earlier
+/// take — the answer is `order.fee`, which is upstream's behaviour and is
+/// never a discounted value in those cases (see [`apply_party_fees`]).
+pub async fn seller_fee_with(pool: &SqlitePool, order_id: &str, amount: i64, order_fee: i64) -> i64 {
+    let row = sqlx::query_as::<_, (i64, i64, i64)>(
+        "SELECT amount, fee_buyer, fee_seller FROM barattolo_fees WHERE order_id = ?1",
+    )
+    .bind(order_id)
+    .fetch_optional(pool)
+    .await;
+    match row {
+        Ok(Some((row_amount, row_fee_buyer, fee_seller)))
+            if row_amount == amount && row_fee_buyer == order_fee && fee_seller >= 0 =>
+        {
+            fee_seller
+        }
+        _ => order_fee,
+    }
+}
+
+/// [`seller_fee_with`] on the global pool, for call sites that have none.
+pub async fn seller_fee(order: &Order) -> i64 {
+    match DB_POOL.get() {
+        Some(pool) => seller_fee_with(pool.as_ref(), &order.id.to_string(), order.amount, order.fee).await,
+        None => order.fee,
+    }
+}
+
+async fn heartbeat(url: reqwest::Url) {
+    // Log on CHANGE only: one line a minute would bury the journal, which is
+    // how the dev-fee retry loop made this node's logs unreadable.
+    static WAS_OK: AtomicBool = AtomicBool::new(true);
+    loop {
+        let ok = http().get(url.clone()).send().await.is_ok();
+        if ok != WAS_OK.swap(ok, Ordering::Relaxed) {
+            if ok {
+                info!("barattolo_fee: marketplace server reachable again");
+            } else {
+                warn!("barattolo_fee: marketplace server unreachable: takes will pay the full fee until it answers");
+            }
+        }
+        tokio::time::sleep(HEARTBEAT_EVERY).await;
+    }
+}
+
+/// Creates the side table and, if the feature is configured, starts the
+/// keep-warm loop. Call once, after the database pool is set.
+pub async fn init() {
+    if let Some(pool) = DB_POOL.get() {
+        if let Err(e) = ensure_table(pool.as_ref()).await {
+            warn!("barattolo_fee: could not create the side table ({e}): everyone pays the full fee");
+        }
+    }
+    let rate = discount_rate();
+    match endpoint() {
+        Some((url, _)) if rate > 0.0 => {
+            info!("barattolo_fee: per-party discount {rate} verified against {url}");
+            match reqwest::Url::parse(&url).and_then(|u| u.join("/api/salute")) {
+                Ok(beat) => {
+                    tokio::spawn(heartbeat(beat));
+                }
+                Err(e) => warn!("barattolo_fee: no keep-warm, bad URL ({e})"),
+            }
+        }
+        _ => info!("barattolo_fee: not configured, everyone pays the full fee"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use sqlx::sqlite::SqlitePoolOptions;
+
+    const BASE: f64 = 0.03;
+    const DISC: f64 = 0.005;
+    // Trade keys made at run time: a 64-hex literal in the repo trips the
+    // secret scanner, and rightly so.
+    fn key(c: char) -> String {
+        std::iter::repeat(c).take(64).collect()
+    }
+
+    async fn pool() -> SqlitePool {
+        // one connection: every connection to `sqlite::memory:` is its own db
+        SqlitePoolOptions::new()
+            .max_connections(1)
+            .connect("sqlite::memory:")
+            .await
+            .unwrap()
+    }
+
+    #[test]
+    fn the_breaker_pauses_after_three_failures_and_resets_on_success() {
+        // two failures: counted, not paused
+        assert_eq!(breaker_after(0, 1_000, false), (1, 0));
+        assert_eq!(breaker_after(1, 1_000, false), (2, 0));
+        // the third in a row: paused for BREAKER_PAUSE, counter back to zero
+        assert_eq!(breaker_after(2, 1_000, false), (0, 1_000 + BREAKER_PAUSE.as_secs()));
+        // a success wipes the count
+        assert_eq!(breaker_after(2, 1_000, true), (0, 0));
+        // and the cap on the answer is well above a real answer
+        assert!(MAX_ANSWER_BYTES >= 4_096);
+    }
+
+    #[test]
+    fn no_discount_is_exactly_upstream_get_fee() {
+        // upstream: round(fee * amount / 2)
+        for amount in [1_i64, 33, 1_000, 7_301, 100_000, 499_999] {
+            let upstream = ((BASE * amount as f64) / 2.0).round() as i64;
+            assert_eq!(party_fee(amount, BASE, 0.0), upstream);
+        }
+        // the first real trade on this node, at 1%: 7301 -> 37 per party
+        assert_eq!(party_fee(7_301, 0.01, 0.0), 37);
+    }
+
+    #[test]
+    fn nobody_one_or_both() {
+        // 100k sats at 3%: 1500 full, 1000 discounted
+        assert_eq!(fees_for(100_000, BASE, DISC, (false, false)), (1_500, 1_500));
+        assert_eq!(fees_for(100_000, BASE, DISC, (true, false)), (1_000, 1_500));
+        assert_eq!(fees_for(100_000, BASE, DISC, (false, true)), (1_500, 1_000));
+        assert_eq!(fees_for(100_000, BASE, DISC, (true, true)), (1_000, 1_000));
+    }
+
+    #[test]
+    fn hold_payout_and_kept_fee_add_up() {
+        let amount = 100_000_i64;
+        for (flags, hold, payout, kept) in [
+            ((false, false), 101_500, 98_500, 3_000),
+            ((true, false), 101_500, 99_000, 2_500),
+            ((false, true), 101_000, 98_500, 2_500),
+            ((true, true), 101_000, 99_000, 2_000),
+        ] {
+            let (fee_buyer, fee_seller) = fees_for(amount, BASE, DISC, flags);
+            assert_eq!(amount + fee_seller, hold);
+            assert_eq!(amount - fee_buyer, payout);
+            assert_eq!(hold - payout, kept);
+        }
+    }
+
+    #[test]
+    fn a_flag_is_a_flag_there_is_nothing_to_stack() {
+        // "pioneer AND level 5" reaches this daemon as one `true`: the
+        // discount is applied once, whatever made the server say yes
+        assert_eq!(party_fee(100_000, BASE, DISC), 1_000);
+    }
+
+    #[test]
+    fn discount_is_capped_and_never_negative() {
+        // a rate above the cap is clamped to the cap (1%): 3%/2 - 1% = 0.5%
+        assert_eq!(party_fee(100_000, BASE, 0.5), 500);
+        // a discount larger than half the base floors at zero
+        assert_eq!(party_fee(100_000, 0.01, MAX_DISCOUNT), 0);
+        assert_eq!(party_fee(100_000, BASE, -1.0), 1_500);
+        assert_eq!(party_fee(100_000, BASE, f64::NAN), 1_500);
+    }
+
+    #[test]
+    fn a_typo_in_the_rate_switches_it_off() {
+        assert_eq!(parse_discount(None), 0.0);
+        assert_eq!(parse_discount(Some("")), 0.0);
+        assert_eq!(parse_discount(Some("mezzo")), 0.0);
+        assert_eq!(parse_discount(Some("-0.005")), 0.0);
+        assert_eq!(parse_discount(Some("NaN")), 0.0);
+        assert_eq!(parse_discount(Some(" 0.005 ")), 0.005);
+        // 0.5 meant as "half a point" is a 50% discount: capped
+        assert_eq!(parse_discount(Some("0.5")), MAX_DISCOUNT);
+    }
+
+    #[test]
+    #[allow(non_snake_case)]
+    fn only_a_literal_true_grants_the_discount() {
+        let (b, s) = (key('a'), key('b'));
+        let (B, S) = (b.as_str(), s.as_str());
+        let ok = format!(r#"{{"ok":true,"sconti":{{"{B}":true,"{S}":false}}}}"#);
+        assert_eq!(parse_answer(&ok, B, S), (true, false));
+        let both = format!(r#"{{"sconti":{{"{B}":true,"{S}":true}}}}"#);
+        assert_eq!(parse_answer(&both, B, S), (true, true));
+        // verification failing, in every shape: full fee
+        assert_eq!(parse_answer("", B, S), (false, false));
+        assert_eq!(parse_answer("<html>502</html>", B, S), (false, false));
+        assert_eq!(parse_answer(r#"{"ok":true}"#, B, S), (false, false));
+        assert_eq!(parse_answer(r#"{"sconti":[]}"#, B, S), (false, false));
+        let missing = format!(r#"{{"sconti":{{"{B}":true}}}}"#);
+        assert_eq!(parse_answer(&missing, B, S), (true, false));
+        let truthy = format!(r#"{{"sconti":{{"{B}":1,"{S}":"true"}}}}"#);
+        assert_eq!(parse_answer(&truthy, B, S), (false, false));
+        // an unknown seller key (empty) never matches anything
+        assert_eq!(parse_answer(r#"{"sconti":{"":true}}"#, B, ""), (false, false));
+    }
+
+    #[test]
+    #[allow(non_snake_case)]
+    fn only_hex_keys_are_sent() {
+        let b = key('a');
+        let B = b.as_str();
+        assert!(is_hex_key(B));
+        assert!(!is_hex_key(""));
+        assert!(!is_hex_key("npub1xyz"));
+        assert!(!is_hex_key(&B[1..]));
+    }
+
+    #[tokio::test]
+    async fn seller_fee_comes_from_the_row_of_this_take() {
+        let pool = pool().await;
+        let id = "11111111-1111-1111-1111-111111111111";
+        // no table, no row: upstream behaviour
+        assert_eq!(seller_fee_with(&pool, id, 100_000, 1_500).await, 1_500);
+        assert!(!has_row(&pool, id).await);
+        // buyer full, seller discounted
+        store(&pool, id, 100_000, 1_500, 1_000, (false, true)).await.unwrap();
+        assert_eq!(seller_fee_with(&pool, id, 100_000, 1_500).await, 1_000);
+        assert!(has_row(&pool, id).await);
+        assert!(!has_row(&pool, "other").await);
+        // another order has no row
+        assert_eq!(seller_fee_with(&pool, "other", 100_000, 1_500).await, 1_500);
+    }
+
+    #[tokio::test]
+    async fn a_stale_row_is_not_trusted() {
+        let pool = pool().await;
+        let id = "22222222-2222-2222-2222-222222222222";
+        store(&pool, id, 100_000, 1_000, 1_000, (true, true)).await.unwrap();
+        // re-taken at a different market amount: the row is from another take
+        assert_eq!(seller_fee_with(&pool, id, 90_000, 1_350).await, 1_350);
+        // same amount, but the order now carries the full buyer fee (the
+        // write of the new row failed): fall back to it
+        assert_eq!(seller_fee_with(&pool, id, 100_000, 1_500).await, 1_500);
+        // a new take overwrites the row
+        store(&pool, id, 100_000, 1_500, 1_500, (false, false)).await.unwrap();
+        assert_eq!(seller_fee_with(&pool, id, 100_000, 1_500).await, 1_500);
+    }
+}
