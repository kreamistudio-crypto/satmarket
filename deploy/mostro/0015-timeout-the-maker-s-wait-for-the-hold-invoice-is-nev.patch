+// ---- PATCH 0015: the maker's time to lock the sats follows his choice ----
+
+/// PURE: the makers' choices in the server's answer, for the ids asked.
+/// Every id asked gets an entry — the window, or 0 for "no choice" — so it
+/// is asked once: the choice of a published order never changes (the
+/// server keeps the first one). A readable answer without the `pubblica`
+/// table is a server older than this patch: all 0, the makers keep their
+/// own window. `None` only for an unreadable answer (asked again).
+pub fn parse_makers(body: &str, asked: &[String]) -> Option<HashMap<String, i64>> {
+    let value: serde_json::Value = serde_json::from_str(body).ok()?;
+    value.get("finestre")?;
+    let table = match value.get("pubblica") {
+        None => return Some(asked.iter().map(|id| (id.clone(), 0)).collect()),
+        Some(t) if t.is_object() => t,
+        Some(_) => return None,
+    };
+    Some(
+        asked
+            .iter()
+            .map(|id| (id.clone(), table.get(id.as_str()).map(window_from).unwrap_or(0)))
+            .collect(),
+    )
+}
+
+pub async fn ensure_maker_table(pool: &SqlitePool) -> Result<(), sqlx::Error> {
+    sqlx::query(
+        "CREATE TABLE IF NOT EXISTS barattolo_maker_windows (
+            order_id TEXT PRIMARY KEY,
+            seconds INTEGER NOT NULL,
+            learned_at INTEGER NOT NULL
+        )",
+    )
+    .execute(pool)
+    .await
+    .map(|_| ())
+}
+
+/// The SELL orders waiting for their maker's hold invoice whose choice is
+/// not known yet, the longest waiting first.
+pub async fn waiting_makers(pool: &SqlitePool) -> Result<Vec<String>, sqlx::Error> {
+    ensure_maker_table(pool).await?;
+    let rows = sqlx::query_as::<_, (uuid::Uuid,)>(
+        "SELECT o.id FROM orders o
+         WHERE o.status = 'waiting-payment' AND o.kind = 'sell'
+           AND NOT EXISTS (SELECT 1 FROM barattolo_maker_windows m WHERE m.order_id = o.id)
+         ORDER BY o.taken_at LIMIT ?1",
+    )
+    .bind(MAX_PER_REQUEST as i64)
+    .fetch_all(pool)
+    .await?;
+    Ok(rows.into_iter().map(|r| r.0.to_string()).collect())
+}
+
+/// Writes the choices. A row already there is never rewritten.
+pub async fn store_makers(
+    pool: &SqlitePool,
+    choices: &HashMap<String, i64>,
+    now: i64,
+) -> Result<(), sqlx::Error> {
+    ensure_maker_table(pool).await?;
+    for (order_id, seconds) in choices {
+        let Ok(id) = uuid::Uuid::parse_str(order_id) else {
+            continue;
+        };
+        let written = sqlx::query(
+            "INSERT OR IGNORE INTO barattolo_maker_windows (order_id, seconds, learned_at)
+             VALUES (?1, ?2, ?3)",
+        )
+        .bind(id)
+        .bind(*seconds)
+        .bind(now)
+        .execute(pool)
+        .await?
+        .rows_affected();
+        if written > 0 && *seconds > 0 {
+            info!(
+                "barattolo_finestra: order {order_id}: the maker has at most {} minutes to lock the sats",
+                seconds / 60
+            );
+        }
+    }
+    Ok(())
+}
+
+/// Drops the choices of orders that left the book and the waiting states
+/// (finished, canceled, or a trade under way): the table stays small.
+pub async fn prune_makers(pool: &SqlitePool) -> Result<(), sqlx::Error> {
+    ensure_maker_table(pool).await?;
+    sqlx::query(
+        "DELETE FROM barattolo_maker_windows WHERE order_id NOT IN
+         (SELECT id FROM orders
+          WHERE status IN ('pending', 'waiting-payment', 'waiting-buyer-invoice'))",
+    )
+    .execute(pool)
+    .await
+    .map(|_| ())
+}
+
+/// The known choices, `{order id: seconds}`, only the real ones (> 0).
+pub async fn maker_windows(pool: &SqlitePool) -> Result<HashMap<String, i64>, sqlx::Error> {
+    ensure_maker_table(pool).await?;
+    let rows = sqlx::query_as::<_, (uuid::Uuid, i64)>(
+        "SELECT order_id, seconds FROM barattolo_maker_windows WHERE seconds > 0",
+    )
+    .fetch_all(pool)
+    .await?;
+    Ok(rows.into_iter().map(|(id, s)| (id.to_string(), s)).collect())
+}
+
+/// The choice of one order, or 0 (none, unknown, or the table unreadable:
+/// then the maker has his own window, as before this patch).
+pub async fn maker_window_of(pool: &SqlitePool, order_id: uuid::Uuid) -> i64 {
+    if ensure_maker_table(pool).await.is_err() {
+        return 0;
+    }
+    sqlx::query_as::<_, (i64,)>(
+        "SELECT seconds FROM barattolo_maker_windows WHERE order_id = ?1",
+    )
+    .bind(order_id)
+    .fetch_optional(pool)
+    .await
+    .ok()
+    .flatten()
+    .map(|r| r.0.max(0))
+    .unwrap_or(0)
+}
+
+/// One refresh of the makers' choices. Never errors: a failure is one log
+/// line on change, and the maker keeps his own window until the server
+/// answers.
+pub async fn refresh_makers(pool: &SqlitePool, now: i64) {
+    static WAS_OK: AtomicBool = AtomicBool::new(true);
+    if let Err(e) = prune_makers(pool).await {
+        warn!("barattolo_finestra: could not prune the makers' choices ({e})");
+    }
+    let ids = match waiting_makers(pool).await {
+        Ok(ids) if !ids.is_empty() => ids,
+        Ok(_) => return,
+        Err(e) => {
+            warn!("barattolo_finestra: could not read the makers' table ({e})");
+            return;
+        }
+    };
+    let answer = match tokio::time::timeout(LOOKUP_BUDGET, ask_raw(&ids)).await {
+        Ok(Ok(raw)) => parse_makers(&raw, &ids).ok_or_else(|| "unreadable answer".to_string()),
+        Ok(Err(reason)) => Err(reason),
+        Err(_) => Err(format!("no answer in {}s", LOOKUP_BUDGET.as_secs())),
+    };
+    match answer {
+        Ok(choices) => {
+            WAS_OK.store(true, Ordering::Relaxed);
+            if let Err(e) = store_makers(pool, &choices, now).await {
+                warn!("barattolo_finestra: could not write the makers' choices ({e})");
+            }
+        }
+        Err(reason) => {
+            if WAS_OK.swap(false, Ordering::Relaxed) {
+                warn!("barattolo_finestra: makers' choices NOT known ({reason}): they keep their own window");
+            }
+        }
+    }
+}
