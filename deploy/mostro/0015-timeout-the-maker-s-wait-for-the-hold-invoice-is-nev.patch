+        // three hours of his own, 30 minutes chosen for the buyer: 30 minutes
+        assert_eq!(maker_window_with_choice(10_800, 1800), 1800);
+        // 24 hours chosen: his three hours stay
+        assert_eq!(maker_window_with_choice(10_800, 86_400), 10_800);
+        // no choice: his own window
