+// PATCH 0015 (Andrea, 19 Nov 2026: «se io pubblico un ordine e imposto il
+// tempo per pagarlo a chi lo prende diciamo 30 minuti, mi sembra giusto che
+// abbia 30 minuti anche chi ha pubblicato»): on a sell order whose maker
+// chose a time to pay, his own window is never longer than that choice.
+// `chosen` is what `barattolo_finestra` learned from the server (0 = none).
+
+/// PURE: the maker's window on ONE order — his own, or the time to pay he
+/// chose for the buyer when that is shorter.
+pub fn maker_window_with_choice(own: u32, chosen: i64) -> u32 {
+    if chosen > 0 {
+        own.min(chosen.min(u32::MAX as i64) as u32)
+    } else {
+        own
+    }
+}
+
+/// The waiting window of whoever holds the duty on an order whose maker's
+/// choice is `chosen`.
+pub fn window_for(status: &str, kind: &str, taker_secs: u32, chosen: i64) -> u32 {
+    window_with(
+        status,
+        kind,
+        taker_secs,
+        maker_window_with_choice(maker_window(taker_secs), chosen),
+    )
+}
+
+/// [`elapsed`] with the maker's choice on that order.
+pub fn elapsed_for(
+    status: &str,
+    kind: &str,
+    taken_at: i64,
+    now: i64,
+    taker_secs: u32,
+    chosen: i64,
+) -> bool {
+    taken_at < now - window_for(status, kind, taker_secs, chosen) as i64
+}
+
+/// PURE: the cutoff of `find_order_by_seconds` once the makers' choices
+/// are known: the shortest of the two windows and of every choice.
+pub fn shortest_window_with(shortest: u32, choices: impl IntoIterator<Item = i64>) -> u32 {
+    choices
+        .into_iter()
+        .filter(|c| *c > 0)
+        .fold(shortest, |m, c| maker_window_with_choice(m, c))
+}
