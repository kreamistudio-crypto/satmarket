+        assert_eq!(maker_window_with_choice(10_800, -5), 10_800);
+        // the cutoff of the query follows the shortest choice
+        assert_eq!(shortest_window_with(1800, vec![3600, 900, 0]), 900);
+        assert_eq!(shortest_window_with(1800, Vec::<i64>::new()), 1800);
+        assert_eq!(shortest_window_with(1800, vec![7200]), 1800);
+    }
