From 68c4587450d8b20e8f02f0a09091e03299ff1707 Mon Sep 17 00:00:00 2001
From: Barattolo <barattolo@barattolo.store>
Date: Thu, 29 Oct 2026 17:53:06 +0000
Subject: [PATCH] config: let dev_fee_percentage = 0 mean no dev fee, not an
 invalid value

---
 src/config/util.rs | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/config/util.rs b/src/config/util.rs
index 2a8a390..7d630e8 100644
--- a/src/config/util.rs
+++ b/src/config/util.rs
@@ -71,10 +71,12 @@ fn apply_nsec_env_override(settings: &mut Settings) {
 fn validate_mostro_settings(settings: &Settings) -> Result<(), MostroError> {
     let dev_fee = settings.mostro.dev_fee_percentage;
 
-    // Validate dev_fee_percentage range
-    if dev_fee < MIN_DEV_FEE_PERCENTAGE {
+    // Validate dev_fee_percentage range. `0` is the explicit opt-out, i.e.
+    // no dev fee at all, so only negatives and the band between zero and the
+    // minimum are rejected. Ordering comparisons only, no float equality.
+    if dev_fee < 0.0 || (dev_fee > 0.0 && dev_fee < MIN_DEV_FEE_PERCENTAGE) {
         return Err(MostroInternalErr(ServiceError::IOError(format!(
-            "dev_fee_percentage ({}) is below minimum ({})",
+            "dev_fee_percentage ({}) is below minimum ({}); use 0 to disable the dev fee",
             dev_fee, MIN_DEV_FEE_PERCENTAGE
         ))));
     }
@@ -1192,6 +1194,13 @@ mod startup_validation_tests {
         assert!(err.to_string().contains("below minimum"));
     }
 
+    #[test]
+    fn dev_fee_zero_is_accepted_as_opt_out() {
+        let mut settings = base_settings();
+        settings.mostro.dev_fee_percentage = 0.0;
+        assert!(validate_mostro_settings(&settings).is_ok());
+    }
+
     #[test]
     fn dev_fee_above_maximum_is_rejected() {
         let mut settings = base_settings();
-- 
2.43.0

