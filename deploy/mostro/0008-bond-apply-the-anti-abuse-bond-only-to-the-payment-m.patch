+#[cfg(test)]
+mod barattolo_bond_methods_tag {
+    // Barattolo fork (patch 0008): the info event names the payment
+    // methods the bond applies to, and only when there are some.
+    use super::bond_policy_tags;
+    use crate::config::types::AntiAbuseBondSettings;
+    use nostr_sdk::prelude::*;
+
+    fn valore(tags: &[Tag], nome: &str) -> Option<String> {
+        tags.iter().find_map(|tag| {
+            let vec = tag.clone().to_vec();
+            if vec.first().map(String::as_str) == Some(nome) {
+                vec.get(1).cloned()
+            } else {
+                None
+            }
+        })
+    }
+
+    #[test]
+    fn only_payment_methods_tag_when_set() {
+        let bond = AntiAbuseBondSettings {
+            enabled: true,
+            only_payment_methods: vec!["Contanti".to_string(), "SEPA".to_string()],
+            ..AntiAbuseBondSettings::default()
+        };
+        let tags = bond_policy_tags(Some(&bond));
+        assert_eq!(
+            valore(&tags, "bond_only_payment_methods").as_deref(),
+            Some("Contanti,SEPA")
+        );
+    }
+
+    #[test]
+    fn no_tag_when_empty_or_disabled() {
+        let ogni = AntiAbuseBondSettings {
+            enabled: true,
+            ..AntiAbuseBondSettings::default()
+        };
+        assert!(valore(&bond_policy_tags(Some(&ogni)), "bond_only_payment_methods").is_none());
+        let spenta = AntiAbuseBondSettings {
+            enabled: false,
+            only_payment_methods: vec!["Contanti".to_string()],
+            ..AntiAbuseBondSettings::default()
+        };
+        assert!(valore(&bond_policy_tags(Some(&spenta)), "bond_only_payment_methods").is_none());
+        assert!(valore(&bond_policy_tags(None), "bond_only_payment_methods").is_none());
+    }
+}
