+/// A bond was slashed (patch 0008): `slashed` is the bonded party's trade
+/// key, `amount` the bond, `node_share` what the node keeps; the rest goes
+/// to the counterparty, and the server reminds them to claim it. Sent only
+/// when the order still names the side, which is where the three callers
+/// stand (the timeout path notifies BEFORE clearing the taker's keys).
+pub fn emit_bond_slashed(order: &Order, slashed: &str, amount: i64, node_share: i64) {
+    if endpoint().is_none() {
+        return;
+    }
+    let side = actor_of(
+        order.buyer_pubkey.as_deref(),
+        order.seller_pubkey.as_deref(),
+        slashed,
+    );
+    if side == "mostro" {
+        warn!(
+            "barattolo_eventi: order {}: slashed key names no side, bond-slashed not sent",
+            order.id
+        );
+        return;
+    }
+    let share = amount.saturating_sub(node_share.max(0)).max(0);
+    let (to_buyer, to_seller) = if side == "buyer" { (0, share) } else { (share, 0) };
+    match event_of("bond-slashed", order, "mostro", Some(side)) {
+        Some(mut event) => {
+            event.sats = Some((amount, to_buyer, to_seller));
+            spawn_delivery(event, None);
+        }
+        None => warn!(
+            "barattolo_eventi: order {}: bond-slashed is not a known action, nothing sent",
+            order.id
+        ),
+    }
+}
