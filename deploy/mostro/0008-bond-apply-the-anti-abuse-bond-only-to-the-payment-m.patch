--- a/src/app/bond/flow.rs
+++ b/src/app/bond/flow.rs
@@ -93,6 +93,42 @@ pub fn maker_bond_required() -> bool {
         .is_some_and(|cfg| cfg.apply_to.applies_to_maker())
 }
 
+/// Barattolo fork (patch 0008): does the node's bond policy cover this
+/// order's payment methods? `only_payment_methods` empty = every order.
+pub fn bond_applies_to_order(order: &Order) -> bool {
+    Settings::get_bond()
+        .map(|cfg| payment_method_in(&order.payment_method, &cfg.only_payment_methods))
+        .unwrap_or(false)
+}
+
+/// Pure half of [`bond_applies_to_order`]: `payment_method` is the order's
+/// comma-separated list, `allowed` the policy's. Whole word, trimmed,
+/// case-insensitive; an empty policy covers everything.
+pub fn payment_method_in(payment_method: &str, allowed: &[String]) -> bool {
+    let allowed: Vec<String> = allowed
+        .iter()
+        .map(|a| a.trim().to_lowercase())
+        .filter(|a| !a.is_empty())
+        .collect();
+    if allowed.is_empty() {
+        return true;
+    }
+    payment_method
+        .split(',')
+        .map(|m| m.trim().to_lowercase())
+        .any(|m| allowed.contains(&m))
+}
+
+/// [`taker_bond_required`] for THIS order (patch 0008).
+pub fn taker_bond_required_for(order: &Order) -> bool {
+    taker_bond_required() && bond_applies_to_order(order)
+}
+
+/// [`maker_bond_required`] for THIS order (patch 0008).
+pub fn maker_bond_required_for(order: &Order) -> bool {
+    maker_bond_required() && bond_applies_to_order(order)
+}
