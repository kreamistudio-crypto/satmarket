+#[cfg(test)]
+mod barattolo_bond_methods {
+    // Barattolo fork (patch 0008): the bond only for the payment methods
+    // the policy names, compared whole-word and case-insensitively.
+    use super::{bond_applies_to_order, maker_bond_required_for, payment_method_in, taker_bond_required_for};
+
+    fn v(a: &[&str]) -> Vec<String> {
+        a.iter().map(|s| s.to_string()).collect()
+    }
+
+    #[test]
+    fn empty_policy_covers_every_method() {
+        assert!(payment_method_in("SEPA", &v(&[])));
+        assert!(payment_method_in("", &v(&[])));
+        assert!(payment_method_in("SEPA", &v(&["", "  "])));
+    }
+
+    #[test]
+    fn whole_word_case_insensitive() {
+        let p = v(&["Contanti"]);
+        assert!(payment_method_in("Contanti", &p));
+        assert!(payment_method_in("contanti", &p));
+        assert!(payment_method_in("Revolut, Contanti", &p));
+        assert!(payment_method_in(" CONTANTI ,SEPA", &p));
+        // Barattozon has its own exact name: a prefix is not a match
+        assert!(!payment_method_in("Contanti al tabacchino 23.47", &p));
+        assert!(!payment_method_in("SEPA,Revolut", &p));
+        assert!(!payment_method_in("", &p));
+    }
+
+    #[test]
+    fn policy_entries_are_trimmed_and_lowercased() {
+        assert!(payment_method_in("contanti", &v(&[" Contanti "])));
+        assert!(payment_method_in("SEPA", &v(&["", "sepa"])));
+    }
+
+    #[test]
+    fn gates_are_off_without_config() {
+        // No global config in unit tests: every gate stays inert, as the
+        // upstream ones do.
+        let order = mostro_core::order::Order {
+            payment_method: "Contanti".to_string(),
+            ..Default::default()
+        };
+        assert!(!bond_applies_to_order(&order));
+        assert!(!taker_bond_required_for(&order));
+        assert!(!maker_bond_required_for(&order));
+    }
+}
